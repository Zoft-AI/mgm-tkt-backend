# =============================================================================
# MGM Ticket Backend - Environment Variables
# =============================================================================
# Phase A: Point DB_HOST to Supabase PostgreSQL (db.<ref>.supabase.co)
# Phase B: Point DB_HOST to AWS RDS (mgm-tkt.xxx.rds.amazonaws.com)
# =============================================================================

# Database (Direct PostgreSQL - works with both Supabase PG and AWS RDS)
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_SSL_MODE=require

# Auth (Custom JWT - no Supabase Auth, no Cognito)
JWT_SECRET=generate-a-64-character-random-string-here-use-openssl-rand-base64-48
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (optional - for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# AWS S3 (File Storage — bucket: boa-application-data, ARN: arn:aws:s3:::boa-application-data)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=boa-application-data

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# App Configuration
ENVIRONMENT_details=development
LOG_LEVEL=INFO
ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001

# SLA Cron
SLA_CRON_SECRET=

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REQUEST_EMAIL_FROM=
REQUEST_EMAIL_NOTIFICATIONS=false
REQUEST_EMAIL_TEST_MODE=true
REQUEST_EMAIL_TEST_RECIPIENT=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
